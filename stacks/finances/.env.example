# Copy to .env (not in git) and fill in real values.

# Public URL of the app; sign-in only works from exactly this origin.
BASE_URL=https://hub.fritz.box:8787
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme
# Creates the first admin on the first start (when no users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
