NEXTAUTH_URL="http://localhost:3030"
INFERENCE_USE_MAX_COMPLETION_TOKENS="true"
CRAWLER_VIDEO_DOWNLOAD="true"
CRAWLER_FULL_PAGE_SCREENSHOT="true"
MEILI_NO_ANALYTICS="true"

# yt-dlp format override: default -f best[filesize<50M] fails hard on sites
# without exact filesize metadata (e.g. Reddit). This tries a 20MB-capped
# format first, falls back to unconstrained best if size-filtered options
# don't exist for the extractor.
CRAWLER_YTDLP_ARGS="-f%%bv*[filesize<20M]+ba[filesize<20M]/b[filesize<20M]/bv*+ba/b%%--merge-output-format%%mp4"

OPENAI_API_KEY="changeme"
NEXTAUTH_SECRET="changeme"
MEILI_MASTER_KEY="changeme"
