{
  "aac-best": {
    "format": "bestaudio[acodec^=mp4a]/bestaudio[ext=m4a]",
    "writethumbnail": true,
    "embed-thumbnail": true,
    "embedthumbnail": true,
    "postprocessors": [
      { "key": "SponsorBlock", "categories": ["music_offtopic"] },
      {
        "key": "ModifyChapters",
        "remove_sponsor_segments": ["music_offtopic"]
      },
      {
        "key": "FFmpegExtractAudio",
        "preferredcodec": "aac",
        "preferredquality": "0"
      },
      { "key": "EmbedThumbnail" },
      { "key": "FFmpegMetadata", "add_metadata": true }
    ]
  }
}
